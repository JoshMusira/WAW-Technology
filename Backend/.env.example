POSTGRES_DB="issue_tracking_app"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace-with-a-strong-database-password"

# Local Docker Compose connection. Hosted deployments should use the provider's DATABASE_URL.
DATABASE_URL="postgresql://postgres:replace-with-a-strong-database-password@localhost:5432/issue_tracking_app?schema=public"
FRONTEND_URL="http://localhost:5173"
API_PORT="3000"
POSTGRES_PORT="5432"

# Generate two different random values of at least 32 characters.
ACCESS_TOKEN_SECRET="replace-with-a-random-access-token-secret"
REFRESH_TOKEN_SECRET="replace-with-a-different-random-refresh-token-secret"
ACCESS_TOKEN_EXPIRES_IN="15m"
